# ─── VibeFlow Environment Configuration ──────────────────────────────────────
# Copy this file to .env and fill in your values

# Absolute path to your local music folder
MUSIC_DIR=D:/Programming/portfolio_projects/VibeFlow/music_library

# SQLite database file location (relative to project root or absolute)
DATABASE_URL=sqlite+aiosqlite:///./vibeflow.db

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# CORS origins for local dev (phone LAN access)
# Add your phone's IP if needed, e.g.: http://192.168.1.100:3000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Server host and port
HOST=0.0.0.0
PORT=8000

# Feature extraction settings
FEATURE_EXTRACTION_WORKERS=4
SAMPLE_RATE=22050
# Duration in seconds to analyse per track (None = full track, e.g. 30 for 30s)
ANALYSIS_DURATION=30

# Genre clustering
N_GENRE_CLUSTERS=12

# Recommendation settings
DAILY_RECOMMENDATION_COUNT=10
WEEKEND_PLAYLIST_COUNT=30
BEHAVIOR_DECAY_HALF_LIFE_DAYS=7
